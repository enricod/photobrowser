[Desktop Entry]
Type=Application
Name=Photobrowser
Comment=Fast photo culling: browse, rate and sort RAW/JPEG folders
Exec=photobrowser %f
Icon=io.github.enricod.PhotoBrowser
Terminal=false
Categories=Graphics;Photography;Viewer;
MimeType=inode/directory;
StartupNotify=true
StartupWMClass=io.github.enricod.PhotoBrowser
